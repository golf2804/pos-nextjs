{
  "name": "pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "nest start --path server/tsconfig.json --watch",
    "build": "next build",
    "build:api": "nest build --path server/tsconfig.json",
    "start": "next start",
    "start:api": "node server/dist/main.js",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:stock": "tsx scripts/test-stock-concurrency.ts",
    "test:notifications": "tsx scripts/test-notifications.ts",
    "test:auth-rbac": "tsx scripts/test-auth-rbac.ts",
    "test:catalog": "tsx scripts/test-catalog-crud.ts",
    "test:users": "tsx scripts/test-user-management.ts",
    "test:reports": "tsx scripts/test-reports.ts",
    "test:e2e": "playwright test",
    "test:performance": "tsx scripts/test-performance-controls.ts",
    "test:production": "tsx scripts/test-production-readiness.ts",
    "test:postgrest": "tsx scripts/test-postgrest-boundary.ts",
    "test:integrity": "tsx scripts/test-inventory-integrity.ts",
    "test:date-boundary": "tsx scripts/test-transaction-date-boundary.ts",
    "test:openapi": "tsx scripts/test-openapi-contract.ts",
    "test:security-controls": "tsx scripts/test-security-controls.ts",
    "test:recovery-controls": "tsx scripts/test-recovery-controls.ts",
    "test:unit": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 tests/unit/*.test.ts",
    "security:dependencies": "npm audit --omit=dev --audit-level=critical",
    "verify": "npm run lint && npm run test:unit && npm run test:recovery-controls && npm run build:api && npm run build",
    "verify:integration": "npm run test:postgrest && npm run test:integrity && npm run test:security-controls && npm run test:openapi && npm run test:date-boundary && npm run test:auth-rbac && npm run test:catalog && npm run test:users && npm run test:reports && npm run test:stock && npm run test:notifications && npm run test:performance && npm run test:production && npm run test:e2e",
    "verify:release": "npm run verify && npm run security:dependencies && npm run verify:integration",
    "user:set-password": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-managed-password.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@nestjs/cli": "^11.0.24",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
